<Window x:Class="D2RTerrorZone.UI.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="D2RTerrorZone Overlay" 
        Width="240" SizeToContent="Height"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        Topmost="{Binding IsTopmost}"
        ShowInTaskbar="False"
        MouseDown="Window_MouseDown"
        FontSize="{Binding FontSize}"
        Opacity="{Binding Opacity}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Border Background="#D0151515" CornerRadius="8" BorderBrush="#40FFFFFF" BorderThickness="1" Margin="5">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="5" ShadowDepth="2" Opacity="0.5"/>
        </Border.Effect>
        <Grid Margin="12,10">
            <!-- 标准模式 -->
            <StackPanel Visibility="{Binding IsStandardMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="🔥 恐惧地带" Foreground="#FFFF8C00" FontWeight="Bold" Margin="0,0,0,8"/>
                
                <TextBlock Text="当前：" Foreground="#FFAAAAAA" FontSize="{Binding FontSize}"/>
                <TextBlock Text="{Binding CurrentZone}" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,8"/>
                
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="⏱ " Foreground="#FF55A0FF"/>
                    <TextBlock Text="{Binding RemainingTime}" Foreground="#FF55A0FF" FontWeight="Bold"/>
                </StackPanel>
                
                <TextBlock Text="下一张：" Foreground="#FFAAAAAA"/>
                <TextBlock Text="{Binding NextZone}" Foreground="White" TextWrapping="Wrap" Margin="0,2,0,8"/>
                
                <Grid Margin="0,4,0,0">
                    <TextBlock Text="{Binding StatusText}" Foreground="#FF888888" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="11"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="📌" Command="{Binding ToggleTopmostCommand}" ToolTip="置顶/取消置顶" Background="Transparent" Foreground="{Binding TopmostIconColor}" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0"/>
                        <Button Content="{Binding LanguageDisplayText}" Command="{Binding SettingsCommand}" ToolTip="切换语言" Background="Transparent" Foreground="#FFAAAAAA" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0"/>
                        <Button Content="↻ 刷新" Command="{Binding RefreshCommand}" Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0"/>
                        <Button Content="✕" Command="{Binding CloseCommand}" Background="Transparent" Foreground="#FF5555" BorderThickness="0" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- 极简模式 -->
            <StackPanel Visibility="{Binding IsMinimalMode, Converter={StaticResource BooleanToVisibilityConverter}}" Orientation="Horizontal">
                <TextBlock Text="🔥 " Foreground="#FFFF8C00" FontWeight="Bold"/>
                <TextBlock Text="{Binding CurrentZone}" Foreground="White" Margin="0,0,8,0" MaxWidth="130" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding RemainingTime}" Foreground="#FF55A0FF" FontWeight="Bold"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
